{
  "audit": "CLUSTOPT ADAPTER SOURCE AUDIT",
  "stage": "4B-2",
  "principle": "the adapter calls these components; it reimplements none of them",
  "entrypoints": [
    {
      "component": "dataset/view meta-feature extraction",
      "module": "models.Clustering_Repository_Builder.features_extraction.feature_extractor",
      "callable": "extract_features_for_view",
      "role": "the only meta-feature extractor; produces the record whose columns the utility predictors consume",
      "importable": true
    },
    {
      "component": "view construction",
      "module": "models.Clustering_Repository_Builder.features_extraction.view_builder",
      "callable": "*",
      "role": "x_only / y_only / xy_2d view construction",
      "importable": true
    },
    {
      "component": "meta-feature vector loading",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.loaders",
      "callable": "load_feature_vector",
      "role": "reads <dataset_dir>/features/features_records.csv and aligns it to a predictor's own feature_columns order",
      "importable": true
    },
    {
      "component": "MLP Full60 utility inference",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.regressor_predictor",
      "callable": "get_regressor_predictor / RegressorPredictor",
      "role": "frozen fold-ensemble MLP utility predictor",
      "importable": true
    },
    {
      "component": "KNN utility inference",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.knn_predictor_provider",
      "callable": "get_knn_provider / KNNUtilityProvider",
      "role": "frozen Phase-E1 KNN utility mechanism (per-view models)",
      "importable": true
    },
    {
      "component": "metric Top-K construction",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.weighting",
      "callable": "select_top_k",
      "role": "descending utility, ties broken by metric name",
      "importable": true
    },
    {
      "component": "RAW weighting",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.weighting",
      "callable": "compute_weights(weighting='normalized_positive')",
      "role": "clip negatives to 0 and normalise to sum 1",
      "importable": true
    },
    {
      "component": "utility -> weights resolution",
      "module": "models.ClustOpt.cluster_validity_indices.dynamic_metric_selection.resolvers",
      "callable": "resolve_regressor_weights / resolve_knn_weights",
      "role": "the authoritative composition of load -> predict -> top-k -> weight",
      "importable": true
    },
    {
      "component": "PP v1 / v2 policy inference",
      "module": "models.ClustOpt_Policy_Predictor.stage2c.run_final_v2_split1_replay",
      "callable": "build_X / split1_features (+ target_transforms.select_policy)",
      "role": "373-dim feature construction and argmax policy selection",
      "importable": true
    },
    {
      "component": "policy set / policy -> regime resolution",
      "module": "models.Clustering_Repository_Builder.experiments.experiment_execution.oof_policy_replay",
      "callable": "build_policy_set",
      "role": "the frozen 20 production policies with source, top_k, weighting",
      "importable": true
    },
    {
      "component": "policy -> reranker mapping",
      "module": "models.ClustOpt_Candidate_Reranker.training.final_models.policy_mapping",
      "callable": "build_mapping / reranker_id",
      "role": "20 policies -> 10 frozen rerankers",
      "importable": true
    },
    {
      "component": "clustering search space",
      "module": "models.ClustOpt.configs.experiments.generate_experiment_configs",
      "callable": "build_search_space",
      "role": "the per-view algorithm/hyper-parameter space shared by every arm",
      "importable": true
    },
    {
      "component": "online clustering search",
      "module": "models.Clustering_Repository_Builder.experiments.experiment_execution.clustopt_execution",
      "callable": "run_experiment_clustopt",
      "role": "builds the ClustOpt pipeline, resolves dynamic CVI, runs Optuna, returns the trial log",
      "importable": true
    },
    {
      "component": "search objective",
      "module": "models.ClustOpt.search_algorithm.Base_Search_Algorithm",
      "callable": "BaseSearchAlgorithm.evaluate_config",
      "role": "aggregate CVI score; ground truth never enters it",
      "importable": true
    },
    {
      "component": "candidate persistence",
      "module": "models.ClustOpt.Search_Results_Logger",
      "callable": "get_search_log_df",
      "role": "one row per evaluated candidate, with per-metric normalised values",
      "importable": true
    },
    {
      "component": "final J selection",
      "module": "models.Clustering_Repository_Builder.experiments.experiment_execution.clustopt_execution",
      "callable": "_best_row / _predict_best_labels",
      "role": "highest aggregate_score candidate, re-instantiated for labels",
      "importable": true
    },
    {
      "component": "reranker feature construction",
      "module": "models.ClustOpt_Candidate_Reranker.split1_preparation.online_feature_builder",
      "callable": "build_online_X",
      "role": "the frozen 347-dim online candidate representation",
      "importable": true
    },
    {
      "component": "reranker inference + final selection",
      "module": "models.ClustOpt_Candidate_Reranker.split1_preparation.evaluate_split1_final",
      "callable": "eligible_mask / select_reranked",
      "role": "argmin predicted regret over eligible candidates, ties to lowest index",
      "importable": true
    }
  ],
